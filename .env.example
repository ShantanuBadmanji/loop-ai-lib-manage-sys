# ---- Application ----
NODE_ENV=development
PORT=3000

# ---- Database ----
# Transactions REQUIRE a replica set. For local Docker, the compose file provides
# a single-node replica set reachable at this URI:
MONGODB_URI=mongodb://localhost:27017/library?replicaSet=rs0
# For MongoDB Atlas (dev), use the SRV connection string instead, e.g.:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/library?retryWrites=true&w=majority

# ---- Auth (stateless JWT access tokens; no refresh/session store) ----
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=3600s

# ---- Loan policy ----
LOAN_PERIOD_DAYS=14
DAMAGE_CLAIM_WINDOW_HOURS=48

# ---- Rate limiting (auth endpoints) ----
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=10

# ---- CORS (comma-separated origins, or *) ----
CORS_ORIGINS=*

# ---- Seed credentials (DEVELOPMENT ONLY — never reuse in production) ----
SEED_LIBRARIAN_EMAIL=librarian@university.edu
SEED_LIBRARIAN_PASSWORD=Librarian@123
SEED_STUDENT_EMAIL=student@university.edu
SEED_STUDENT_PASSWORD=Student@123
